diff --git a/cmake/FindPcre2.cmake b/cmake/FindPcre2.cmake
new file mode 100644
index 0000000..cdfe07a
--- /dev/null
+++ b/cmake/FindPcre2.cmake
@@ -0,0 +1,18 @@
+FIND_PATH(PCRE2_INCLUDES pcre2.h
+  HINTS
+  ${PCRE2_INCLUDE_DIR}
+  $ENV{PCRE2_INCLUDE_DIR}
+  /usr
+  PATH_SUFFIXES include
+)
+
+FIND_LIBRARY(PCRE2_LIB pcre2-8
+  HINTS
+  ${PCRE2_LIB_DIR}
+  $ENV{PCRE2_LIB_DIR}
+  /usr
+  PATH_SUFFIXES lib
+)
+
+INCLUDE(FindPackageHandleStandardArgs)
+FIND_PACKAGE_HANDLE_STANDARD_ARGS(Pcre2 DEFAULT_MSG PCRE2_LIB PCRE2_INCLUDES)
\ No newline at end of file

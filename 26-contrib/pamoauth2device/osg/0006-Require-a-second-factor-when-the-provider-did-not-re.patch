+    EXPECT_EQ(config.mfa_acr_values.size(), 1);
+    EXPECT_EQ(config.mfa_amr_values.count("mfa"), 1);
+}
+
+TEST(ConfigTest, MfaRejectsMalformedSection)
+{
+    for (char const *fixture : {"data/template_mfa_badpolicy.json",
